   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "ROOT = Path.cwd().resolve()\n",
    "while ROOT.name != \"experimentos\":\n",
    "    ROOT = ROOT.parent\n",
    "\n",
    "if str(ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(ROOT))\n",
    "\n",
    "from runner import run_experiment\n",
    "\n",
    "resultado = run_experiment()\n"
   ]
  }
